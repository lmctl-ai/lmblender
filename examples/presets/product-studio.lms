out = ARGV.len() > 0 ? ARGV[0] : "build/preset-product-studio.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let sphere = scene.uv_sphere(0.9,24,16,true);
let cube = scene.cube(1.2); cube.translate(1.6,0.0,0.0);
scene.use_preset("product-studio");
sphere.set_material(scene.material_from_palette("metal"));
cube.set_material(scene.material_from_palette("accent"));
scene.preset_param("samples",16.0);
scene.render_settings(2,17,true);
scene.render_png("build/preset-product-studio.png",8,320,240);
end _dsl_
savedsl(p,out);
// system() stops a program after 60 s by default; renders can take longer.
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println(trim(run.stdout));
