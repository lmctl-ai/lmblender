out = ARGV.len() > 0 ? ARGV[0] : "build/preset-turntable-neutral.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let sphere = scene.uv_sphere(0.9,24,16,true);
let cube = scene.cube(1.2); cube.translate(1.6,0.0,0.0);
scene.use_preset("turntable-neutral");
sphere.set_material(scene.material_from_palette("neutral"));
cube.set_material(scene.material_from_palette("accent"));
scene.preset_param("samples",16.0);
scene.render_settings(2,17,true);
scene.render_png("images/preset-turntable-neutral.png",8,320,240);
end _lmcode_
savedsl(p,out);
// The long system() timeout lets slow regression renders finish (default is 60 s).
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println("wrote images/preset-turntable-neutral.png");
