out = ARGV.len() > 0 ? ARGV[0] : "build/preset-external.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let cube = scene.cube(1.5);
scene.load_preset("examples/presets/technical-clean.external.json");
cube.set_material(scene.material_from_palette("body"));
scene.preset_param("samples",16.0);
scene.render_settings(2,17,true);
scene.render_png("images/preset-external.png",8,320,240);
end _dsl_
savedsl(p,out);
// The long system() timeout lets slow regression renders finish (default is 60 s).
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println("wrote images/preset-external.png");
