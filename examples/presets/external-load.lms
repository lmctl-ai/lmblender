out = ARGV.len() > 0 ? ARGV[0] : "build/preset-external.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@v0.3.2";
let cube = scene.cube(1.5);
scene.load_preset("examples/presets/technical-clean.external.json");
cube.set_material(scene.material_from_palette("body"));
scene.preset_param("samples",16.0);
scene.render_settings(2,17,true);
scene.render_png("build/preset-external.png",8,320,240);
end _dsl_
savedsl(p,out);
run = system ${dsl_cli(p)} --dsl ${out};
if (run.code != 0) { println(f"lmblender exit {run.code}: {trim(run.stderr)}"); exit(1); }
