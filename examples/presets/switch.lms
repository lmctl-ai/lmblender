out = ARGV.len() > 0 ? ARGV[0] : "build/preset-switch.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
scene.cube(1.2);
scene.use_preset("product-studio");
let accent = scene.material_from_palette("accent");
let ball = scene.uv_sphere(0.7,24,16,true); ball.translate(1.5,0.0,0.0); ball.set_material(accent);
scene.use_preset("technical-clean");
let cube = scene.cube(0.8); cube.translate(-1.5,0.0,0.0); cube.set_material(accent);
scene.preset_param("samples",16.0);
scene.render_settings(2,17,true);
scene.render_png("images/preset-switch.png",16,320,240);
end _lmcode_
savedsl(p,out);
// The long system() timeout lets slow regression renders finish (default is 60 s).
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println("wrote images/preset-switch.png");
