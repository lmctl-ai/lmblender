out = ARGV.len() > 0 ? ARGV[0] : "build/version.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
scene.version();
end _dsl_
savedsl(p, out);
run = system ${dsl_cli(p)} --dsl ${out};
if (run.code != 0) { println(f"lmblender exit {run.code}: {trim(run.stderr)}"); exit(1); }
