// Two OBJ cubes: a UV-mapped red checker with a bump map, and a glossy blue cube.
out = ARGV.len() > 0 ? ARGV[0] : "build/obj-mtl-gallery.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let pair = scene.import_obj("tests/fixtures/obj-mtl/study.obj");
scene.expect_int(pair.vertex_count(), 16);
scene.expect_int(pair.triangle_count(), 24);
scene.expect_int(pair.material_count(), 2);
scene.checker_ground(8.0, 4.0);
scene.world_color(0.34, 0.37, 0.42, 0.55);
scene.area_light(-3.0, -4.0, 6.0, 0.0, 0.0, 0.8, 1.0, 0.90, 0.78, 1000.0, 4.0);
scene.camera_look_at(0.0, -7.5, 4.0, 0.0, 0.0, 0.85, 42.0);
scene.render_settings(8, 1928, false);
scene.render_png("images/obj-mtl-gallery.png", 32, 640, 480);
end _dsl_
savedsl(p, out);
// The long system() timeout lets slow regression renders finish (default is 60 s).
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println("wrote images/obj-mtl-gallery.png");
