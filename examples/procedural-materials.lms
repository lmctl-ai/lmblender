out = ARGV.len() > 0 ? ARGV[0] : "build/procedural-materials.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let checker_mesh = scene.import_obj("tests/fixtures/tetra.obj");
checker_mesh.translate(-2.4, 0.0, 0.0);
let checker = scene.checker_material(0.9, 0.12, 0.035, 0.95, 0.78, 0.34, 4.0, 0.36);
checker_mesh.set_material(checker);
let noise_mesh = scene.instance_mesh(checker_mesh, 2.4, 0.0, 0.0, 1.0, 1.0, 1.0);
let noise = scene.noise_material(0.018, 0.075, 0.24, 0.13, 0.42, 0.68, 3.5, 0.42);
noise_mesh.set_material(noise);
scene.ground_plane(-0.18, 80.0, 0.24, 0.26, 0.3);
scene.world_color(0.08, 0.1, 0.14, 0.24);
scene.sun_light(0.2, -0.5, -1.0, 1.0, 0.9, 0.78, 2.2, 0.3);
scene.spot_light(-5.0, -6.0, 7.0, -2.4, 0.0, 1.2, 1.0, 0.72, 0.5, 420.0, 48.0, 0.25);
scene.area_light(3.0, -5.0, 7.0, 2.4, 0.0, 1.0, 0.65, 0.82, 1.0, 1900.0, 5.0);
scene.camera_look_at(0.0, -15.0, 2.0, 0.0, 0.0, 2.0, 35.0);
scene.render_settings(8, 31, false);
scene.render_png("images/procedural-materials.png", 96, 640, 480);
end _dsl_
savedsl(p, out);
// The long system() timeout lets slow regression renders finish (default is 60 s).
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println("wrote images/procedural-materials.png");
