out = ARGV.len() > 0 ? ARGV[0] : "build/camera-dof.dslb";
p = _dsl_ schema="../schema/lmblender.dsl.json";
let near = scene.import_obj("tests/fixtures/tetra.obj");
near.translate(-2.0, 0.0, 0.0);
let red = scene.material(0.9, 0.06, 0.03, 0.0, 0.6, 0.0, 0.9, 0.06, 0.03, 0.5);
near.set_material(red);
let far = scene.import_obj("tests/fixtures/tetra.obj");
far.translate(2.0, 0.0, -5.0);
let blue = scene.material(0.03, 0.1, 0.9, 0.0, 0.6, 0.0, 0.03, 0.1, 0.9, 0.5);
far.set_material(blue);
scene.camera_look_at(0.0, -17.0, 5.0, 0.0, 0.0, 0.0, 42.0);
scene.camera_dof(1.5, 17.5);
scene.render_png("build/camera-dof.png", 32, 640, 480);
end _dsl_
savedsl(p, out);
