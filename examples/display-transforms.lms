out = ARGV.len() > 0 ? ARGV[0] : "build/display-transforms.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let panel = scene.import_obj("tests/fixtures/emission-panel.obj");
let emitter = scene.material(0.0, 0.0, 0.0, 0.0, 0.5, 0.0, 0.18, 0.18, 0.18, 1.0);
panel.set_material(emitter);
scene.world_color(0.0, 0.0, 0.0, 0.0);
scene.camera_orthographic(0.0, 0.0, 4.0, 0.0, 0.0, 0.0, 4.0);
scene.set_view_transform("Standard");
scene.render_png("build/display-standard.png", 8, 64, 64);
scene.set_view_transform("Filmic");
scene.render_png("build/display-filmic.png", 8, 64, 64);
scene.set_view_transform("AgX");
scene.render_png("build/display-agx.png", 8, 64, 64);
end _dsl_
savedsl(p, out);
// system() stops a program after 60 s by default; renders can take longer.
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println(trim(run.stdout));
