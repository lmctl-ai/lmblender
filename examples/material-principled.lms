out = ARGV.len() > 0 ? ARGV[0] : "build/material-principled.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let mesh = scene.import_obj("tests/fixtures/tetra.obj");
scene.world_color(0.08, 0.42, 0.12, 0.5);
scene.point_light(-4.0, -3.0, 7.0, 1.0, 0.82, 0.62, 550.0);
let blue = scene.material(0.08, 0.18, 0.85, 0.1, 0.32, 0.0, 0.08, 0.18, 0.85, 2.0);
mesh.set_material(blue);
scene.render_png("images/material-principled.png", 32, 256, 192);
end _lmcode_
savedsl(p, out);
// The long system() timeout lets slow regression renders finish (default is 60 s).
argv = dsl_cli(p);
push(argv, "--lmcode");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println("wrote images/material-principled.png");
