out = ARGV.len() > 0 ? ARGV[0] : "build/material-principled.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let mesh = scene.import_obj("tests/fixtures/tetra.obj");
scene.world_color(0.08, 0.42, 0.12, 0.5);
scene.point_light(-4.0, -3.0, 7.0, 1.0, 0.82, 0.62, 550.0);
let blue = scene.material(0.08, 0.18, 0.85, 0.1, 0.32, 0.0, 0.08, 0.18, 0.85, 2.0);
mesh.set_material(blue);
scene.render_png("build/material-principled.png", 32, 256, 192);
end _dsl_
savedsl(p, out);
run = system ${dsl_cli(p)} --dsl ${out};
if (run.code != 0) { println(f"lmblender exit {run.code}: {trim(run.stderr)}"); exit(1); }
