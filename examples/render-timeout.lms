out = ARGV.len() > 0 ? ARGV[0] : "build/render-timeout.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let mesh = scene.import_obj("tests/fixtures/tetra.obj");
scene.render_timeout(1);
scene.render_png("build/render-timeout.png", 65536, 1024, 1024);
end _dsl_
savedsl(p, out);
run = system ${dsl_cli(p)} --dsl ${out};
if (run.code == 0) { println("expected this example to fail validation or time out"); exit(1); }
