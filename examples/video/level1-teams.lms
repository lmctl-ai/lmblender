out = ARGV.len() > 0 ? ARGV[0] : "build/level1.dslb";
mkdir("images");
mkdir("images/video");
mkdir("build");
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
scene.world_color(0.015, 0.024, 0.055, 0.8);
scene.ground_plane(-2.0, 30.0, 0.035, 0.055, 0.10);
scene.area_light(-4.0, -6.0, 8.0, 0.0, 0.0, 0.0, 0.55, 0.72, 1.0, 900.0, 5.0);
let blue = scene.glow_orb(-4.0,0.0,0.5,0.62,0.12,0.48,1.0,2.6);
let teal = scene.glow_orb(0.0,0.0,0.5,0.62,0.12,0.92,0.72,2.4);
let violet = scene.glow_orb(4.0,0.0,0.5,0.62,0.60,0.28,1.0,2.5);
let b1=scene.glow_orb(-5.0,0.4,0.55,0.18,0.28,0.64,1.0,1.2); let b2=scene.glow_orb(-3.0,0.4,0.55,0.18,0.28,0.64,1.0,1.2);
let t1=scene.glow_orb(-1.0,0.4,0.55,0.18,0.2,1.0,0.8,1.2); let t2=scene.glow_orb(1.0,0.4,0.55,0.18,0.2,1.0,0.8,1.2);
let v1=scene.glow_orb(3.0,0.4,0.55,0.18,0.7,0.4,1.0,1.2); let v2=scene.glow_orb(5.0,0.4,0.55,0.18,0.7,0.4,1.0,1.2);
let g1=scene.ring_arc(-4.0,0.0,0.5,1.18,0.065,-80.0,160.0,64); let g2=scene.ring_arc(0.0,0.0,0.5,1.18,0.065,-80.0,245.0,64); let g3=scene.ring_arc(4.0,0.0,0.5,1.18,0.065,-80.0,280.0,64);
let white=scene.material(0.8,0.9,1.0,0.0,0.6,0.0,0.0,0.0,0.0,0.8);
let l1=scene.label("CODER",-0.50,0.0,0.0,0.20); l1.rotate_x(90.0); l1.translate(-4.0,-0.90,-1.45); l1.set_material(white);
let l2=scene.label("RESEARCH",-0.80,0.0,0.0,0.18); l2.rotate_x(90.0); l2.translate(0.0,-0.90,-1.45); l2.set_material(white);
let l3=scene.label("PLANNER",-0.70,0.0,0.0,0.20); l3.rotate_x(90.0); l3.translate(4.0,-0.90,-1.45); l3.set_material(white);
scene.camera_look_at(0.0,-16.0,6.0,0.0,0.0,0.1,44.0);
scene.camera_keyframe(0,0.0,-16.0,6.0,0.0,0.0,0.1,"ease");
scene.camera_keyframe(8,-2.0,-10.0,4.4,-2.0,0.0,0.4,"ease");
scene.camera_keyframe(23,0.0,-16.0,6.0,0.0,0.0,0.1,"ease");
scene.render_preset("draft"); scene.render_settings(4,0,true); scene.render_sequence("images/video/level1-{frame}.png",0,23,0,640,360);
end _dsl_
savedsl(p, out);
// The long system() timeout lets slow regression renders finish (default is 60 s).
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println("wrote images/video/level1-<frame>.png");
