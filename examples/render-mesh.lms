out = ARGV.len() > 0 ? ARGV[0] : "build/imported-mesh.png";
bytecode = ARGV.len() > 1 ? ARGV[1] : "build/render-mesh.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@v0.3.2";
let mesh = scene.import_obj("tests/fixtures/tetra.obj");
scene.expect_int(mesh.vertex_count(), 4);
scene.expect_int(mesh.triangle_count(), 4);
scene.render_png("build/imported-mesh.png", 32, 256, 192);
end _dsl_
savedsl(p, bytecode);
run = system ${dsl_cli(p)} --dsl ${bytecode};
if (run.code != 0) { println(f"lmblender exit {run.code}: {trim(run.stderr)}"); exit(1); }
