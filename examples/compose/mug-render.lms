out = ARGV.len() > 0 ? ARGV[0] : "build/compose-mug.dslb";
p = _dsl_ schema="../../schema/lmblender.dsl.json";
let mesh = scene.import_stl("build/compose-input/build/mug.stl");
let ceramic = scene.material(0.08, 0.38, 0.62, 0.05, 0.28, 0.0, 0.08, 0.38, 0.62, 1.5);
mesh.set_material(ceramic);
scene.world_color(0.12, 0.16, 0.22, 0.35);
scene.point_light(-10.0, -15.0, 18.0, 1.0, 0.82, 0.66, 1200.0);
scene.camera_look_at(18.0, -25.0, 18.0, 0.0, 0.0, 0.0, 48.0);
scene.render_settings(8, 17, false);
scene.render_png("build/compose-mug.png", 32, 384, 288);
end _dsl_
savedsl(p, out);
