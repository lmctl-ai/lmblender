out = ARGV.len() > 0 ? ARGV[0] : "build/compose-plate.dslb";
p = _dsl_ schema="../../schema/lmblender.dsl.json";
let mesh = scene.import_stl("build/compose-input/build/plate-with-holes.stl");
let alloy = scene.material(0.72, 0.22, 0.08, 0.35, 0.3, 0.0, 0.72, 0.22, 0.08, 1.2);
mesh.set_material(alloy);
scene.world_color(0.11, 0.14, 0.2, 0.3);
scene.point_light(-10.0, -14.0, 20.0, 1.0, 0.85, 0.7, 1200.0);
scene.camera_look_at(8.0, -12.0, 10.0, 0.0, 0.0, 0.0, 48.0);
scene.render_settings(8, 23, false);
scene.render_png("build/compose-plate.png", 32, 384, 288);
end _dsl_
savedsl(p, out);
