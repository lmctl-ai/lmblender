out = ARGV.len() > 0 ? ARGV[0] : "build/bracket.dslb";
p = _dsl_ schema="/home/ubuntu/repos/lmcad/schema/lmcad.dsl.json";
let metal = material().color(0.58, 0.62, 0.68).roughness(0.32);
let base = scene.box(8.0, 5.0, 0.8, metal).position(0.0, 0.0, 0.4).name("bracket base");
let back = scene.box(8.0, 0.8, 5.0, metal).position(0.0, 2.1, 2.9).name("bracket back");
let left = scene.box(0.8, 4.0, 2.8, metal).position(-3.6, -0.1, 2.2).name("bracket left flange");
let right = scene.box(0.8, 4.0, 2.8, metal).position(3.6, -0.1, 2.2).name("bracket right flange");
base.union(back); back.visible(false);
base.union(left); left.visible(false);
base.union(right); right.visible(false);
scene.export_stl("build/bracket.stl");
end _dsl_
savedsl(p, out);
