out = ARGV.len() > 0 ? ARGV[0] : "build/obj-mtl-invalid.dslb";
p = _lmcode_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let pair = scene.import_obj("tests/fixtures/obj-mtl/study-bad.obj");
scene.render_png("build/obj-mtl-invalid.png", 8, 64, 64);
end _lmcode_
savedsl(p, out);
argv = dsl_cli(p);
push(argv, "--lmcode");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code != 0) { println(f"lmblender exit {run.code}: {trim(run.stderr)}"); exit(1); }
