// An external preset with camera.auto_frame=false and no camera.position used to leave
// the camera at the world origin (a NaN basis when geometry is centered there). It must
// now be refused with PRESET_INVALID at load time.
out = ARGV.len() > 0 ? ARGV[0] : "build/preset-no-autoframe.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let ball = scene.uv_sphere(1.0, 32, 16, true);
scene.load_preset("tests/presets/no-autoframe-missing.json");
scene.render_png("build/preset-no-autoframe.png", 1, 16, 16);
end _dsl_
savedsl(p, out);
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code == null) { println("lmblender child timed out"); exit(1); }
if (run.code == 0) { println("expected PRESET_INVALID for a preset without auto-framing or a camera position"); exit(1); }
