out = ARGV.len() > 0 ? ARGV[0] : "build/sequence-budget.dslb";
p = _lmcode_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let sphere = scene.uv_sphere(1.0, 16, 8, true);
scene.set_threads(2);
scene.render_sequence("build/should-not-render-{frame}.png", 0, 239, 8, 960, 540);
end _lmcode_
savedsl(p, out);
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code == null) { println("lmblender child timed out"); exit(1); }
if (run.code == 0) { println("expected this example to fail validation or time out"); exit(1); }
