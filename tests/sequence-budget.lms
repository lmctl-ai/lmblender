out = ARGV.len() > 0 ? ARGV[0] : "build/sequence-budget.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@v0.3.2";
let sphere = scene.uv_sphere(1.0, 16, 8, true);
scene.set_threads(2);
scene.render_sequence("build/should-not-render-{frame}.png", 0, 239, 8, 960, 540);
end _dsl_
savedsl(p, out);
run = system ${dsl_cli(p)} --dsl ${out};
if (run.code == 0) { println("expected this example to fail validation or time out"); exit(1); }
