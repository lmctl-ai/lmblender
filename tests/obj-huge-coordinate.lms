out = ARGV.len() > 0 ? ARGV[0] : "build/obj-huge-coordinate.dslb";
p = _lmcode_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let mesh = scene.import_obj("tests/fixtures/obj-mtl/study-huge-coordinate.obj");
scene.expect_int(mesh.vertex_count(), 16);
end _lmcode_
savedsl(p, out);
