// An external preset with camera.auto_frame=false and an explicit camera.position (in
// scene-radius units around the geometry center) must place the camera and render a lit
// subject; tests/pixel_bounds_quality.py checks the frame is not blank.
out = ARGV.len() > 0 ? ARGV[0] : "build/preset-no-autoframe-position.dslb";
p = _lmcode_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let ball = scene.uv_sphere(1.0, 32, 16, true);
scene.load_preset("tests/presets/no-autoframe-position.json");
scene.render_png("build/preset-no-autoframe-position.png", 4, 64, 64);
end _lmcode_
savedsl(p, out);
argv = dsl_cli(p);
push(argv, "--lmcode");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code != 0) { println(f"lmblender exit {run.code}: {trim(run.stderr)}"); exit(1); }
