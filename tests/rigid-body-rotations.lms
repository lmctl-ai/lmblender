out = ARGV.len() > 0 ? ARGV[0] : "build/rigid-body-rotations.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let x = scene.cube(1.0);
x.rotate_x(30.0);
x.translate(-1.8, 0.0, 0.0);
if (x.max_y() < 0.67 || x.min_y() > -0.67) { scene.expect_int(0, 1); }
let y = scene.cube(1.0);
y.rotate_y(45.0);
if (y.max_x() < 0.70 || y.min_x() > -0.70) { scene.expect_int(0, 1); }
let z = scene.cube(1.0);
z.rotate_z(60.0);
if (z.max_x() < 0.67 || z.min_x() > -0.67) { scene.expect_int(0, 1); }
z.translate(1.8, 0.0, 0.0);
scene.camera_orthographic(0.0, -8.0, 2.2, 0.0, 0.0, 0.5, 5.2);
scene.world_color(0.02, 0.03, 0.05, 0.7);
scene.point_light(-3.0, -4.0, 5.0, 1.0, 0.85, 0.7, 500.0);
scene.render_settings(4, 17, false);
scene.render_png("build/rigid-body-rotations.png", 8, 320, 180);
end _dsl_
savedsl(p, out);
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
if (run.code != 0) { println(trim(f"lmblender exit {run.code}: {trim(run.stdout)} {trim(run.stderr)}")); exit(1); }
println(trim(run.stdout));
