// depth_range(near, far) widens depth-pass contrast (tests/depth_range_quality.py).
out = ARGV.len() > 0 ? ARGV[0] : "build/depth-range.dslb";
mkdir("build");
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let near = scene.cube(1.0);
near.translate(-1.6, -1.0, 0.5);
let mid = scene.uv_sphere(0.6, 32, 16, true);
mid.translate(0.0, 2.5, 0.6);
let far = scene.cone(0.6, 1.4, 32, true);
far.translate(1.6, 6.0, 0.7);
scene.ground_plane(0.0, 60.0, 0.5, 0.5, 0.5);
scene.camera_look_at(0.0, -6.0, 2.0, 0.0, 2.5, 0.5, 45.0);
scene.render_passes("build/depth-auto", 4, 320, 240);
scene.depth_range(4.0, 14.0);
scene.render_passes("build/depth-ranged", 4, 320, 240);
end _dsl_
savedsl(p, out);
