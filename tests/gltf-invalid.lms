out = ARGV.len() > 0 ? ARGV[0] : "build/gltf-invalid.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let broken = scene.import_gltf("tests/fixtures/gltf/malformed-json.glb");
end _dsl_
savedsl(p, out);
run = system ${dsl_cli(p)} --dsl ${out};
if (run.code == 0) { println("expected this example to fail validation or time out"); exit(1); }
