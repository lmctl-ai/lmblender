out = ARGV.len() > 0 ? ARGV[0] : "build/rotation-normals-rotated.dslb";
p = _lmcode_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
let mesh = scene.import_obj("tests/fixtures/obj-mtl/study-flat.obj");
mesh.rotate_y(35.0);
scene.camera_orthographic(0.0, -8.0, 0.85, 0.0, 0.0, 0.85, 5.5);
scene.world_color(0.12, 0.14, 0.18, 0.8);
scene.point_light(-3.0, -4.0, 5.0, 1.0, 0.85, 0.7, 500.0);
scene.render_settings(8, 23, false);
scene.render_png("build/rotation-normals-rotated.png", 8, 320, 180);
end _lmcode_
savedsl(p, out);
