// Whole-program budget: a loop of cheap host calls far too long to finish (hours at
// native speed). test.sh runs this bytecode with LMBLENDER_MAX_INSTRUCTIONS lowered
// (expects RUN_BUDGET) and with LMBLENDER_RUN_TIMEOUT_SECONDS=1 plus the instruction
// ceiling disabled (expects RUN_TIMEOUT); both must exit non-zero with the standard JSON
// result line instead of running to completion.
out = ARGV.len() > 0 ? ARGV[0] : "build/run-budget.dslb";
p = _dsl_ cli="lmblender" install="github:lmctl-ai/lmblender@latest";
for (i in range(0, 4000000000)) {
  scene.expect_int(i, i);
}
end _dsl_
savedsl(p, out);
argv = dsl_cli(p);
push(argv, "--dsl");
push(argv, out);
run = system(argv, 3600000);
println(trim(run.stdout));
if (run.code == null) { println("lmblender child timed out"); exit(1); }
if (run.code == 0) { println("expected the program budget to stop this loop"); exit(1); }
